# =====================================================================
# Jack African Fashion — 环境变量模板
# ---------------------------------------------------------------------
# 用法：
#   cp .env.example .env.local      # 然后填入你自己的值
#   npm run dev                     # Next.js 会自动加载 .env.local
#
# ⚠️ 重要：
#   1) .env.local 已被 .gitignore 忽略（规则 `.env.*` + `!.env.example`），**绝不要提交真实凭据**。
#   2) 本文件中所有值都是**占位值**，没有任何一个是可用的真实密码或密钥。
#   3) 生产环境缺少任一 [必需] 变量时，应用会**直接拒绝启动**（见 src/lib/auth.ts）。
# =====================================================================

# ===================
# 管理员认证配置
# ===================

# 管理员用户名 [必需 - 生产环境]
ADMIN_USERNAME=admin

# 管理员密码 [必需 - 生产环境]
# 要求：12+ 字符，包含大小写字母、数字与特殊字符
# 本机开发若不设置，会退回到源码中的开发占位口令，并打印 [SECURITY] 告警
ADMIN_PASSWORD=change-me-to-a-strong-password

# 会话签名密钥 [必需 - 生产环境]
# 用途：对管理员会话 Cookie 做 HMAC-SHA256 签名，防止会话伪造
# 要求：至少 32 字符的随机串；生产环境长度不足会直接抛错
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-random-32-byte-hex-string

# ===================
# 网站配置
# ===================

# 站点 URL [可选]
# 用途：生成 sitemap、robots、Open Graph 分享链接等绝对 URL
# 开发环境：http://localhost:3000
# 生产环境：https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# 以下为可选扩展项，当前代码未使用，留作后续接入预留
# =====================================================================

# 数据库（当前商品数据以 JSON 文件持久化，迁移到 DB 时启用）
# DATABASE_URL=postgresql://user:password@localhost:5432/jack_fashion

# Redis 缓存
# REDIS_URL=redis://localhost:6379

# 图片云存储
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# 分析工具
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 错误监控
# SENTRY_DSN=https://your-dsn@sentry.io/your-project
